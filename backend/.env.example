# Copy this file to `.env` and fill in real values.

# Google Gemini API key (required)
GOOGLE_API_KEY=your-google-api-key-here

# MongoDB connection string (required for saving sessions / regeneration tracking)
# Local: MONGODB_URI=mongodb://localhost:27017
# Atlas: MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/
MONGODB_URI=mongodb://localhost:27017

# Database name used inside MongoDB
MONGODB_DB=qc_checklist
